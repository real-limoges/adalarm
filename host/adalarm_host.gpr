with "config/adalarm_host_config.gpr";
project Adalarm_Host is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Adalarm_Host_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("adalarm_host.adb");

   package Compiler is
      for Default_Switches ("Ada") use Adalarm_Host_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Adalarm_Host;
